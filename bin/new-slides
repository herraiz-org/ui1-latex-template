set -euo pipefail

USAGE="Usage: new-slides [OPTIONS] <directory>

Scaffold a new Beamer presentation directory using the ui1beamer theme.

Required flags:
  --titulo      TITLE      Presentation title
  --autor       NAME       Author name

Optional flags:
  --subtitulo   SUBTITLE   Presentation subtitle
  --asignatura  SUBJECT    Subject name
  --fecha       DATE       Date in Spanish format (default: today)
  --dry-run                Print resolved values without creating files
  --help                   Show this help and exit"

TITULO=""
SUBTITULO=""
ASIGNATURA=""
AUTOR=""
FECHA=""
DRY_RUN=false
TARGET_DIR=""

usage_error() {
  echo "Error: $1" >&2
  echo "" >&2
  echo "$USAGE" >&2
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help)
      echo "$USAGE"
      exit 0
      ;;
    --titulo)
      TITULO="${2:?$(usage_error "--titulo requires a value")}"
      shift 2
      ;;
    --subtitulo)
      SUBTITULO="${2:?$(usage_error "--subtitulo requires a value")}"
      shift 2
      ;;
    --asignatura)
      ASIGNATURA="${2:?$(usage_error "--asignatura requires a value")}"
      shift 2
      ;;
    --autor)
      AUTOR="${2:?$(usage_error "--autor requires a value")}"
      shift 2
      ;;
    --fecha)
      FECHA="${2:?$(usage_error "--fecha requires a value")}"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --*)
      usage_error "Unknown flag: $1"
      ;;
    *)
      if [[ -n "$TARGET_DIR" ]]; then
        usage_error "Unexpected argument: $1"
      fi
      TARGET_DIR="$1"
      shift
      ;;
  esac
done

[[ -n "$TITULO" ]]     || usage_error "--titulo is required"
[[ -n "$AUTOR" ]]      || usage_error "--autor is required"
[[ -n "$TARGET_DIR" ]] || usage_error "positional directory argument is required"

if [[ -z "$FECHA" ]]; then
  FECHA=$(LC_ALL=es_ES.UTF-8 date "+%-d de %B de %Y" 2>/dev/null || date "+%Y-%m-%d")
fi

if "$DRY_RUN"; then
  echo "Dry run — resolved values:"
  echo "  titulo:     $TITULO"
  echo "  subtitulo:  $SUBTITULO"
  echo "  asignatura: $ASIGNATURA"
  echo "  autor:      $AUTOR"
  echo "  fecha:      $FECHA"
  echo "  directory:  $TARGET_DIR"
  exit 0
fi

if [[ -d "$TARGET_DIR" ]]; then
  echo "Error: directory '$TARGET_DIR' already exists" >&2
  exit 1
fi

mkdir -p "$TARGET_DIR"

BASENAME=$(basename "$TARGET_DIR")

cat > "$TARGET_DIR/${BASENAME}.tex" <<TEX
% aspectratio=169 must stay on \\documentclass: it is a Beamer class option
% and cannot be set by the theme.
\\documentclass[aspectratio=169]{beamer}
\\usetheme{ui1beamer}

% ==============================================================
% FILL IN YOUR DETAILS BELOW
% ==============================================================
\\title{${TITULO}}
\\subtitle{${SUBTITULO}}
\\asignatura{${ASIGNATURA}}
\\author{${AUTOR}}
\\date{${FECHA}}
% ==============================================================

\\begin{document}

\\begin{frame}[plain]
  \\titlepage
\\end{frame}

\\section{Introducción}

\\begin{frame}{Primera transparencia}
  \\begin{itemize}
    \\item Primer punto.
    \\item Segundo punto.
  \\end{itemize}

  \\begin{block}{Idea principal}
    El contenido destacado va aquí.
  \\end{block}
\\end{frame}

\\end{document}
TEX

cat > "$TARGET_DIR/Makefile" <<'MAKEFILE'
MAIN    := $(shell basename $(CURDIR))
LATEX   := pdflatex
FLAGS   := -interaction=nonstopmode

.PHONY: pdf clean open

pdf:
	$(LATEX) $(FLAGS) $(MAIN).tex
	$(LATEX) $(FLAGS) $(MAIN).tex

clean:
	rm -f *.aux *.log *.out *.pdf *.toc *.nav *.snm *.vrb

open: pdf
	xdg-open $(MAIN).pdf
MAKEFILE

echo "Presentation created in '$TARGET_DIR'."
echo ""
echo "Next steps:"
echo "  cd $TARGET_DIR"
echo "  make pdf     # compile"
echo "  make open    # open PDF"
echo "  make clean   # remove auxiliary files"
